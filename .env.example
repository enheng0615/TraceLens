# Never commit a real API key. Copy this file to .env and fill it locally.
SOPHON_MODEL_API_KEY=
SOPHON_MODEL_ID=DeepSeek-V4-Flash-Sophon
SOPHON_OPERATOR_EMAIL=your.name@bytedance.com
SOPHON_MODEL_ENDPOINT=https://sophon-ai.bytedance.net/gateway/openapi/model/chatCompletion

# Values from the provided Sophon curl example.
SOPHON_SCENE_SCOPE=1
SOPHON_SCENE_TYPE=1
SOPHON_IS_AGENT=2
SOPHON_TEMPERATURE=0.01

# Local metadata used by Pi for context/output limits.
SOPHON_CONTEXT_WINDOW=128000
SOPHON_MAX_TOKENS=8192

# OpenAI (optional; only required when using openai-model.mjs)
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.4

# Anthropic (optional; only required when using anthropic-model.mjs)
# ANTHROPIC_OAUTH_TOKEN takes precedence when both credentials are present.
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# Trace RCA runtime (optional)
SOPHON_TRANSPORT_RETRIES=2
RCA_MAX_MODEL_PROMPT_CHARS=65000
